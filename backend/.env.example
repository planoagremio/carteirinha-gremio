# Copiar para .env e preencher os valores reais
# cp .env.example .env

# Banco de dados
DATABASE_URL=postgresql://gremio:TROQUE_A_SENHA@localhost:5434/gremio_acesso

# JWT — gerar com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=TROQUE_ESTA_CHAVE

# Credenciais — admin (acesso total)
USUARIO=admin
# Gerar hash: python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('sua-senha'))"
SENHA_HASH=TROQUE_O_HASH

# Credenciais — recepção (somente leitura de membros + registrar entrada)
USUARIO_RECEPCAO=recepcao
SENHA_HASH_RECEPCAO=TROQUE_O_HASH

# Ambiente: desenvolvimento | producao
AMBIENTE=desenvolvimento

# Origens permitidas no CORS (separadas por vírgula)
# Em desenvolvimento: * ou http://localhost:5500
# Em produção: URL onde o HTML está hospedado
CORS_ORIGINS=*
